generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Habit {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  checkins  Checkin[]
}

model Checkin {
  id        String   @id @default(cuid())
  habitId   String
  date      DateTime
  createdAt DateTime @default(now())
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([date])
}
